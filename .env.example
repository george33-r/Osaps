APP_NAME="Osapa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite for local development; PostgreSQL recommended for production.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=osapa
# DB_USERNAME=osapa
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sanctum: domains whose browser requests get cookie sessions (the SPA). Include the Vite dev port.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:8000

# --- Marketplace rules (placeholders — confirm with the business before launch) ---
BRAND_NAME="Osapa"
FEE_CUSTOMER_SERVICE_BPS=250
FEE_CUSTOMER_SERVICE_CAP_MINOR=500000
FEE_TAILOR_COMMISSION_BPS=1000
OFFER_EXPIRY_HOURS=48
OFFER_MAX_COUNTER_ROUNDS=3
OFFER_MAX_LIVE_PER_TAILOR=15
OFFER_MAX_PER_REQUEST=20
REQUEST_OPEN_DAYS=7
REQUEST_MAX_OPEN_PER_CUSTOMER=10

# --- Not yet integrated (Phase 4 / Phase 5) ---
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=
# AI_PROVIDER=
# AI_API_KEY=
