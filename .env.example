APP_NAME="OSAPS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite for local development; PostgreSQL recommended for production.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=osaps
# DB_USERNAME=osaps
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true on the live HTTPS site so session cookies are never sent over plain HTTP.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sanctum: domains whose browser requests get cookie sessions (the SPA). Include the Vite dev port.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:8000

# --- Marketplace rules (placeholders — confirm with the business before launch) ---
BRAND_NAME="OSAPS"
FEE_CUSTOMER_SERVICE_BPS=250
FEE_CUSTOMER_SERVICE_CAP_MINOR=500000
FEE_TAILOR_COMMISSION_BPS=1000
OFFER_EXPIRY_HOURS=48
OFFER_MAX_COUNTER_ROUNDS=3
OFFER_MAX_LIVE_PER_TAILOR=15
OFFER_MAX_PER_REQUEST=20
REQUEST_OPEN_DAYS=7
REQUEST_MAX_OPEN_PER_CUSTOMER=10

# Install link token: 32+ letters/digits, works once. Delete the line after use.
# INSTALL_TOKEN=
# Optional fixed password for demo accounts; otherwise each seeder run prints a new random one.
# DEMO_PASSWORD=

# --- Support and brand (optional) ---
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# A licensed campaign photograph for the homepage hero (URL). Leave empty to show illustrated catalogue fabric.
BRAND_CAMPAIGN_IMAGE=
BRAND_CAMPAIGN_CAPTION=
# Keep false until someone is assigned to resolve disputes.
DISPUTES_ENABLED=false

# --- AI (optional). Without a key every feature runs in its rule-based mode and says so. ---
# Server-side only: never put this key in the web/ frontend or commit it.
AI_API_KEY=
# AI_MODEL=claude-haiku-5-5
# AI_VISION_MODEL=
# AI_TIMEOUT=25
# AI_DAILY_LIMIT_USER=60
# AI_DAILY_LIMIT_IP=30
# AI_PER_MINUTE=8
# AI_DAILY_LIMIT_GLOBAL=400

# --- Payments (Paystack) ---
# Server-side only. Start with your TEST secret key (sk_test_...), pay with a Paystack test card,
# then swap in the LIVE key (sk_live_...). Set the webhook URL in the Paystack dashboard to
# https://YOUR-DOMAIN/api/v1/webhooks/paystack. Without a key, the shop shows "contact the vendor".
PAYSTACK_SECRET_KEY=

# --- Fabric shop (placeholders — confirm before launch) ---
# SHOP_SERVICE_FEE_BPS=250
# SHOP_SERVICE_FEE_CAP_MINOR=500000
# SHOP_VENDOR_COMMISSION_BPS=500
# SHOP_DELIVERY_FEE_MINOR=300000
# SHOP_CHECKOUT_HOLD_MINUTES=60
# SHOP_OFFER_FLOOR_BPS=7000
# SHOP_OFFER_RESPONSE_HOURS=24
# SHOP_OFFER_HOLD_HOURS=48
# SHOP_OFFER_MAX_ROUNDS=3

# --- Diaspora (placeholders: set real values before switching on) ---
# Approximate display rates, naira per one unit. 0 hides that currency.
FX_GBP=0
FX_USD=0
FX_EUR=0
FX_CAD=0
# FX_UPDATED="12 Oct 2026"
# International shipping per vendor parcel, in kobo (2800000 = ₦28,000). 0 = not offered.
SHIP_UK_MINOR=0
SHIP_US_MINOR=0
SHIP_CA_MINOR=0
SHIP_EU_MINOR=0
SHIP_AFRICA_MINOR=0
SHIP_OTHER_MINOR=0
# SHOP_AUTO_COMPLETE_DAYS=3

# --- WhatsApp updates (Meta Cloud API). Off until both are set. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=osaps_update
# WHATSAPP_TEMPLATE_LANGUAGE=en

# --- "See it on me" try-on (image AI). Off until set. Server-side only. ---
# TRYON_PROVIDER=openai
# TRYON_OPENAI_API_KEY=
# TRYON_DAILY_LIMIT=5
# TRYON_DAILY_LIMIT_GLOBAL=200
